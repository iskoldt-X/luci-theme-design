#!/bin/sh
# luci-theme-design-x — rpcd ubus object exposing read-only system
# metrics to the theme's frontend JS, replacing the legacy
# unauthenticated /cgi-bin/design/* endpoints (Codex P1-6 fix).
#
# Contract (rpcd convention):
#   $1 = "list"  → emit JSON describing available methods + arg types
#   $1 = "call"  $2 = <method>  → read JSON args from stdin, emit JSON result
#
# Auth: LuCI's authenticated session is granted "read" access to all
# methods via /usr/share/rpcd/acl.d/luci-theme-design-x.json. Anonymous
# callers get rpcd's standard "Access denied" — the unauthenticated
# public exposure that the old CGIs had is now closed.
#
# Round 42 Step 163: SKELETON. All 6 methods declared but return
# placeholder JSON so the frontend can be wired against the new
# transport in a smoke-test mode before real implementation lands.
# Step 164 fills in `devstats` (canonical pattern) + frontend switch.
# Step 165 fills in the remaining 5.
# Step 232 (Round 45): host-traffic / host-traffic-acct / nlbw methods
# removed alongside the traffic.js widget.
# Step 242 (Round 46): list-blocks (read) + block-mac / unblock-mac (write)
# added for the Clients-card Block button. State lives in kernel nftables
# (set `inet design_x blocked_macs`) + on-disk skeleton at
# /usr/share/nftables.d/ruleset-post/design_x.nft. Active surface is now 8:
# devstats / cpustat / temp / host-presence / wifi-stations / list-blocks
# / block-mac / unblock-mac.

# ──────────────────────────────────────────────────────────────────────
# Helpers (Step 242)
# ──────────────────────────────────────────────────────────────────────

NFT_FILE="/usr/share/nftables.d/ruleset-post/design_x.nft"

# Validate a MAC string against ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ using
# shell case-pattern (busybox ash, no Bash bashisms). Returns 0 if valid.
# Same discipline as Step 153 hostname sanitize — refuse anything that
# could end up as a literal nft token risk.
mac_valid() {
	case "$1" in
		[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F])
			return 0 ;;
		*)
			return 1 ;;
	esac
}

# Ensure our nft table exists in kernel. On first install (or after a
# kernel module reload that wipes nftables state) the table is missing
# until fw4 next includes the skeleton file. Make the rpcd handler
# robust by reapplying our skeleton on-demand if `nft list set` fails.
ensure_table() {
	if ! nft list set inet design_x blocked_macs >/dev/null 2>&1; then
		[ -r "$NFT_FILE" ] && nft -f "$NFT_FILE" 2>/dev/null
	fi
}

# Rewrite $NFT_FILE so the set's `elements = { ... }` clause reflects
# the current kernel state. Read kernel state via `nft -j` (JSON) since
# the text form spans multiple lines and is awkward to parse in shell.
# After regenerate, the on-disk skeleton matches kernel; reboot replays
# the same set membership via fw4's normal ruleset-post include path.
regenerate_state_file() {
	mkdir -p /etc/design-x
	(
		flock -x 9

		if ! nft list set inet design_x blocked_macs >/dev/null 2>&1; then
			exit 1
		fi

		elems=""
		sep=""
		: > /etc/design-x/blocked_macs.tmp
		for m in $(nft -j list set inet design_x blocked_macs 2>/dev/null \
			| jsonfilter -e '@.nftables[*].set.elem[*]' 2>/dev/null); do
			elems="$elems$sep$m"
			sep=", "
			echo "$m" >> /etc/design-x/blocked_macs.tmp
		done
		mv /etc/design-x/blocked_macs.tmp /etc/design-x/blocked_macs

		elems_clause=""
		[ -n "$elems" ] && elems_clause="
		elements = { $elems }"

		cat > "${NFT_FILE}.tmp" <<NFT_EOF
# luci-theme-design-x — Round 46 Step 242 — Block feature
# Auto-regenerated by /usr/libexec/rpcd/luci-theme-design-x on every
# Block / Unblock action. To wipe all blocks manually:
#     rm $NFT_FILE && fw4 reload
#
# Step 242b atomic-replace prelude — see same comment in skeleton.

table inet design_x
delete table inet design_x

table inet design_x {
	set blocked_macs {
		type ether_addr$elems_clause
	}

	chain block_forward {
		type filter hook forward priority filter; policy accept;
		ether saddr @blocked_macs counter drop
		ether daddr @blocked_macs counter drop
	}

	chain block_input {
		type filter hook input priority filter; policy accept;
		ether saddr @blocked_macs counter drop
	}

	chain block_output {
		type filter hook output priority filter; policy accept;
		ether daddr @blocked_macs counter drop
	}
}
NFT_EOF
		mv "${NFT_FILE}.tmp" "$NFT_FILE"
	) 9>"/var/lock/design_x_block.lock"
}

case "$1" in
	list)
		# Method declarations: name → expected args (type hint only).
		# Empty {} = method takes no args.
		echo '{ "devstats": {"dev":"string"}, "cpustat": {}, "temp": {}, "host-presence": {}, "wifi-stations": {}, "list-blocks": {}, "block-mac": {"mac":"string"}, "unblock-mac": {"mac":"string"} }'
		;;

	call)
		# Args JSON arrives on stdin per rpcd contract.
		INPUT=$(cat)

		case "$2" in
			devstats)
				# Read /sys/class/net/<dev>/statistics/{rx,tx}_bytes plus
				# operstate. Mirrors root/www/cgi-bin/design/devstats
				# verbatim — same input sanitization, same response shape
				# (HTTP 200 + error payload on bad input, NOT HTTP 400 —
				# tester agent flagged this contract; JS consumer relies
				# on it at wan-stats.js: `if (!data || data.error) ...`).
				DEV=$(echo "$INPUT" | jsonfilter -e '@.dev' 2>/dev/null)
				# Strict filter: only [A-Za-z0-9._-] survives, defends
				# against path traversal even if the next check were
				# bypassed.
				DEV=$(printf '%s' "$DEV" | tr -cd 'a-zA-Z0-9._-')
				case "$DEV" in
					""|"."|".."|*..*) DEV="" ;;
				esac
				if [ -z "$DEV" ] || [ ! -d "/sys/class/net/$DEV/statistics" ]; then
					# Error shape preserved: NO `dev` key, has `error` key.
					echo '{"error":"invalid device","rx_bytes":0,"tx_bytes":0,"up":false}'
				else
					RX=$(cat "/sys/class/net/$DEV/statistics/rx_bytes" 2>/dev/null || echo 0)
					TX=$(cat "/sys/class/net/$DEV/statistics/tx_bytes" 2>/dev/null || echo 0)
					UP="false"
					[ "$(cat /sys/class/net/$DEV/operstate 2>/dev/null)" = "up" ] && UP="true"
					printf '{"dev":"%s","up":%s,"rx_bytes":%s,"tx_bytes":%s}\n' \
						"$DEV" "$UP" "$RX" "$TX"
				fi
				;;
			cpustat)
				# /proc/stat first line — cumulative CPU time accounting in
				# USER_HZ jiffies. Mirrors root/www/cgi-bin/design/cpustat:
				# busy = total - idle - iowait (iowait counts as idle per
				# kernel convention). Frontend computes deltas across polls.
				read _cpu user nice system idle iowait irq softirq steal _guest _guest_nice < /proc/stat
				: "${user:=0}"   "${nice:=0}"    "${system:=0}"  "${idle:=0}"
				: "${iowait:=0}" "${irq:=0}"     "${softirq:=0}" "${steal:=0}"
				total=$((user + nice + system + idle + iowait + irq + softirq + steal))
				busy=$((total - idle - iowait))
				printf '{"user":%s,"nice":%s,"system":%s,"idle":%s,"iowait":%s,"irq":%s,"softirq":%s,"steal":%s,"total":%s,"busy":%s}\n' \
					"$user" "$nice" "$system" "$idle" "$iowait" "$irq" "$softirq" "$steal" "$total" "$busy"
				;;
			temp)
				# Thermal zone scan — kernel exposes millidegrees,
				# convert to whole degrees C. Empty array when no
				# sensors. Mirrors root/www/cgi-bin/design/temp.
				TEMPS=""
				for z in /sys/class/thermal/thermal_zone*/temp; do
					[ -r "$z" ] || continue
					T=$(cat "$z" 2>/dev/null) || continue
					[ -n "$T" ] || continue
					[ -n "$TEMPS" ] && TEMPS="$TEMPS,"
					TEMPS="$TEMPS$((T / 1000))"
				done
				printf '{"zones":[%s]}\n' "$TEMPS"
				;;
			host-presence)
				# Round 44 Step 218 — real "last seen" data source for
				# LAN Clients. Combines:
				#   /proc/net/arp           — wired host presence + ARP flag
				#   iwinfo <iface> assoclist — wireless inactive_ms
				#
				# Replaces the misleading "lease remaining time" → "last
				# seen" rename done in Round 38 Step 140 (which honestly
				# admitted the data was wrong — DHCP lease validity says
				# NOTHING about whether the device is currently active).
				#
				# Output shape (keyed by uppercase MAC, no colons):
				#   { "AABBCCDDEEFF": {
				#         "via": "wifi" | "arp",
				#         "iface": "<dev>",
				#         "state": "active" | "stale",
				#         "inactive_ms": <int>     (wifi only)
				#     },
				#     ... }
				#
				# Hosts not in this map are absent from both arp and any
				# iwinfo assoclist → caller treats as offline.

				# Find IPs with established connections to port 80, 443, or 22
				MGMT_MACS=""
				if command -v netstat >/dev/null 2>&1; then
					for ip in $(netstat -tn 2>/dev/null | awk '$6=="ESTABLISHED" && $4~/:80$|:443$|:22$/ { ip=$5; sub(/:[^:]+$/, "", ip); sub(/^::ffff:/, "", ip); print ip }' | sort -u); do
						mac=$(awk -v ip="$ip" '$1==ip { gsub(":", "", $4); print toupper($4); exit }' /proc/net/arp 2>/dev/null)
						[ -n "$mac" ] && MGMT_MACS="$MGMT_MACS $mac "
					done
				fi

				# Helper: walk all wifi devices, emit each station's
				# `"MAC":{via:wifi, iface:N, inactive_ms:N, state:active|stale}`
				# (active when inactive < 60_000 ms, else stale).
				wifi_json=""
				if command -v ubus >/dev/null 2>&1; then
					iwinfo_devices=$(ubus call iwinfo devices 2>/dev/null | \
						jsonfilter -e '@.devices[*]' 2>/dev/null)
					for dev in $iwinfo_devices; do
						case "$dev" in *[!A-Za-z0-9_-]*) continue ;; esac
						stations=$(ubus call iwinfo assoclist "{\"device\":\"$dev\"}" 2>/dev/null)
						[ -z "$stations" ] && continue
						# Emit one "MAC":{...} entry per station. jsonfilter
						# returns "MAC inactive" pairs newline-separated.
						pairs=$(echo "$stations" | \
							jsonfilter -e '@.results[@.mac, @.inactive]' 2>/dev/null)
						mac=""
						for line in $pairs; do
							if [ -z "$mac" ]; then
								mac="$line"
							else
								ms="$line"
								[ "$ms" -eq "$ms" ] 2>/dev/null || ms=0
								state="active"
								[ "$ms" -gt 60000 ] 2>/dev/null && state="stale"
								mac_valid "$mac" || { mac=""; continue; }
								mac_key=$(echo "$mac" | tr -d ':' | tr 'a-f' 'A-F')
								is_mgmt="false"
								case " $MGMT_MACS " in *" $mac_key "*) is_mgmt="true" ;; esac
								[ -n "$wifi_json" ] && wifi_json="$wifi_json,"
								wifi_json="$wifi_json\"$mac_key\":{\"via\":\"wifi\",\"iface\":\"$dev\",\"state\":\"$state\",\"inactive_ms\":$ms,\"is_mgmt\":$is_mgmt}"
								mac=""
							fi
						done
					done
				fi

				# Helper: walk /proc/net/arp, emit entries with flag 0x2
				# (ATF_COM — kernel believes entry is valid). MACs already
				# in wifi_json should NOT be re-emitted (wifi data is more
				# specific).
				arp_json=""
				if [ -r /proc/net/arp ]; then
					arp_json=$(awk -v wifi="$wifi_json" -v mgmt=" $MGMT_MACS " '
						BEGIN { first = 1 }
						# Skip header row
						NR == 1 { next }
						{
							ip = $1; flags = $3; mac = toupper($4); iface = $6
							# Skip incomplete entries (flag 0x0) and zero MAC
							if (flags == "0x0") next
							if (mac == "00:00:00:00:00:00" || mac == "") next
							# Filter MACs already covered by wifi data —
							# detect by presence of "MACKEY":  in wifi string
							key = mac
							gsub(":", "", key)
							if (index(wifi, "\"" key "\":") > 0) next
							is_mgmt = (index(mgmt, " " key " ") > 0) ? "true" : "false"
							if (!first) printf ","
							printf "\"%s\":{\"via\":\"arp\",\"iface\":\"%s\",\"state\":\"active\",\"is_mgmt\":%s}", key, iface, is_mgmt
							first = 0
						}
					' /proc/net/arp)
				fi

				# Compose final JSON. wifi entries first (more specific),
				# arp entries follow.
				printf '{"hosts":{'
				printf '%s' "$wifi_json"
				if [ -n "$wifi_json" ] && [ -n "$arp_json" ]; then printf ','; fi
				printf '%s' "$arp_json"
				printf '}}\n'
				;;
			wifi-stations)
				# Wi-Fi assoclist via iwinfo ubus. Mirrors root/www/cgi-bin/
				# design/wifi-stations verbatim — same probe order, same
				# device-name allowlist, same per-interface stitching with
				# ubus payloads passed through VERBATIM (no jsonfilter on
				# the inner info/assoclist responses — preserves field
				# order + number types that the JS consumer relies on).
				if ! command -v ubus >/dev/null 2>&1; then
					echo '{"available":false,"interfaces":{},"reason":"no-ubus"}'
				else
					DEVICES_JSON=$(ubus call iwinfo devices 2>/dev/null)
					if [ -z "$DEVICES_JSON" ]; then
						echo '{"available":false,"interfaces":{},"reason":"no-iwinfo"}'
					else
						DEVICES=$(echo "$DEVICES_JSON" | jsonfilter -e '@.devices[*]' 2>/dev/null)
						if [ -z "$DEVICES" ]; then
							echo '{"available":true,"interfaces":{}}'
						else
							printf '{"available":true,"interfaces":{'
							FIRST=1
							for dev in $DEVICES; do
								case "$dev" in
									*[!A-Za-z0-9_-]*) continue ;;
								esac
								INFO=$(ubus call iwinfo info "{\"device\":\"$dev\"}" 2>/dev/null)
								ASSOC=$(ubus call iwinfo assoclist "{\"device\":\"$dev\"}" 2>/dev/null)
								: "${INFO:={}}"
								: "${ASSOC:={}}"
								[ $FIRST -eq 0 ] && printf ','
								printf '"%s":{"info":%s,"assoclist":%s}' "$dev" "$INFO" "$ASSOC"
								FIRST=0
							done
							printf '}}\n'
						fi
					fi
				fi
				;;
			list-blocks)
				# Step 242 (Round 46) — return JSON array of currently-blocked
				# MACs from kernel nft state (authoritative live data). Kernel
				# > disk for "what's blocked right now" since manual `nft add
				# element` from CLI would otherwise be invisible.
				ensure_table
				MACS=$(nft -j list set inet design_x blocked_macs 2>/dev/null \
					| jsonfilter -e '@.nftables[*].set.elem[*]' 2>/dev/null)
				OUT="["
				SEP=""
				for m in $MACS; do
					OUT="$OUT$SEP\"$m\""
					SEP=","
				done
				OUT="$OUT]"
				echo "{\"macs\":$OUT}"
				;;

			block-mac)
				# Step 242 (Round 46) — add a MAC to inet design_x.blocked_macs.
				# Validate strictly server-side (Step 153 lesson: don't trust the
				# client). Idempotent — re-blocking an already-blocked MAC
				# returns ok without error.
				MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null)
				if ! mac_valid "$MAC"; then
					echo '{"error":"invalid-mac","mac":""}'
					exit 0
				fi
				# Normalize to lowercase for nft consistency
				MAC=$(printf '%s' "$MAC" | tr 'A-F' 'a-f')
				ensure_table
				# nft add element is idempotent — re-adding is silently OK
				if nft add element inet design_x blocked_macs "{ $MAC }" 2>/dev/null; then
					regenerate_state_file
					echo "{\"ok\":true,\"mac\":\"$MAC\"}"
				else
					echo "{\"error\":\"nft-add-failed\",\"mac\":\"$MAC\"}"
				fi
				;;

			unblock-mac)
				# Step 242 (Round 46) — remove a MAC from the set. Same
				# validation, same idempotence policy (unblocking a not-blocked
				# MAC returns ok).
				MAC=$(echo "$INPUT" | jsonfilter -e '@.mac' 2>/dev/null)
				if ! mac_valid "$MAC"; then
					echo '{"error":"invalid-mac","mac":""}'
					exit 0
				fi
				MAC=$(printf '%s' "$MAC" | tr 'A-F' 'a-f')
				ensure_table
				nft delete element inet design_x blocked_macs "{ $MAC }" 2>/dev/null
				# Even if delete failed (MAC wasn't in set), regenerate so file
				# reflects current kernel state. UX: caller can't tell the
				# difference, which is what we want for idempotence.
				regenerate_state_file
				echo "{\"ok\":true,\"mac\":\"$MAC\"}"
				;;

			*)
				# Unknown method — rpcd will treat this as method not found
				# but we emit something parseable just in case.
				echo '{"error":"unknown-method"}'
				;;
		esac
		;;
esac
