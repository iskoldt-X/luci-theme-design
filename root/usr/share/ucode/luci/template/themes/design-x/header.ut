{#-
	Material is a clean HTML5 theme for LuCI. It is based on luci-theme-bootstrap and MUI

	luci-theme-material
	Copyright 2015-2017 Lutty Yang <lutty@wcan.in>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/LuttyYang/luci-theme-material/issues

	luci-theme-bootstrap:
	Copyright 2008 Steven Barth <steven@midlink.org>
	Copyright 2008-2016 Jo-Philipp Wich <jow@openwrt.org>
	Copyright 2012 David Menting <david@nut-bolt.nl>

	MUI:
	https://github.com/muicss/mui

	luci-theme-design-x (Round 42 fork)

	Licensed to the public under the Apache License 2.0
-#}

{%-
	// LuCI 24.10+ ucode template runtime pre-populates these globals:
	//   media, resource, lang, csrf_token, luciversion, luciname, distversion
	//   boardinfo, request, request_path, nodespec, path
	//   url(), include(), striptags(), pcdata(), translate(), translatef()
	//   dispatcher.lookup(), http.prepare_content(), fs, ubus
	// No `require` statements needed (Lua-side counterpart loaded
	// luci.sys / luci.util / luci.http / luci.dispatcher / luci.version
	// — all surfaced as template globals here).

	// Step 87 (Round 14): per-deploy cache-buster token used on all
	// theme-asset `?v=` URLs below.
	//
	// Why: LuCI's default cache-buster is luciversion (e.g.
	// "26.136.30825~c9cbaea") which only changes when LuCI itself
	// upgrades. That means every dev-sync rsync writes new JS/CSS but
	// the browser keeps serving cached copies.
	//
	// How: scripts/dev-sync.sh writes /tmp/luci-design.cachebust on the
	// router after each successful rsync. We read it here and append
	// to our asset URLs. End users (no dev-sync file) fall back to
	// luciversion, identical to pre-Step-87 behaviour. /tmp is tmpfs
	// (RAM) so reboot wipes it — falls back cleanly.
	//
	// Bonus: line ~71 also gets `cb` instead of luciversion. LuCI's own
	// luci.js extracts ?v=... from its own <script src=...> and uses
	// it as env.resource_version for ALL L.require() calls — cascade.
	let cb = luciversion;
	let fd = fs.open("/tmp/luci-design.cachebust", "r");
	if (fd) {
		let v = fd.read("line");
		fd.close();
		if (v) {
			v = replace(v, /\n$/, "");
			if (length(v) > 0) cb = v;
		}
	}

	// Step 153 (Round 40) — root-no-password warning.
	//
	// Lua original used:
	//   luci.sys.process.info("uid") == 0
	//   luci.sys.user.getuser("root")
	//   luci.sys.user.getpasswd("root")
	//
	// On 24.10+ LuCI runs as non-root via rpcd. The uid check is
	// misleading (always false now). /etc/shadow is 0600 owned by
	// root so a non-root template can't read it directly.
	//
	// Try fs.access first — fail-closed if denied (no warning shown).
	// The Lua track at luasrc/view/themes/design-x/header.htm still
	// shows the warning on systems with luci-lua-runtime installed.
	// TODO(round-42+): expose root-pw status via an rpcd ACL'd object
	// so the warning works on ucode-only systems too.
	let root_no_pw = false;
	if (fs.access("/etc/shadow", "r")) {
		let sf = fs.open("/etc/shadow", "r");
		if (sf) {
			let line;
			while ((line = sf.read("line")) !== null) {
				if (substr(line, 0, 5) == "root:") {
					let parts = split(line, ":");
					let hash = parts[1];
					if (hash == "" || hash == "!" || hash == "*") {
						root_no_pw = true;
					}
					break;
				}
			}
			sf.close();
		}
	}

	http.prepare_content("text/html; charset=UTF-8");
-%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
	<title>{{ striptags( (boardinfo.hostname || "OpenWrt") + ( (nodespec && nodespec.title) ? ' - ' + translate(nodespec.title) : '') ) }} - LuCI</title>

	<meta name="format-detection" content="telephone=no, email=no"/>
	<meta name="theme-color" media="(prefers-color-scheme: light)" content="white">
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content="black">
	<meta name="application-name" content="{{ striptags( boardinfo.hostname || "OpenWrt" ) }} - LuCI">

	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="default" />
	<meta name="apple-mobile-web-app-title" content="{{ striptags( boardinfo.hostname || "OpenWrt" ) }} - LuCI">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="msapplication-TileColor" content="#09c">

	<link rel="manifest" href="{{ media }}/manifest.json">
	<link rel="icon" href="{{ media }}/images/icon.png" sizes="192x192">
	<link rel="apple-touch-icon" sizes="192x192" href="{{ media }}/images/icon.png">
	<link rel="shortcut icon" type="image/png" href="{{ media }}/images/icon.png">

	<link rel="stylesheet" href="{{ media }}/css/style.css?v={{ cb }}">
	{#- Step 67 (Round 11): features.css used to be @import-ed from the end
	    of style.css. CSS spec says @import must come BEFORE all other rules
	    — Edge/Chrome stopped honouring our trailing @import on 2026-05-23,
	    breaking every feature card on Overview. Loading via a separate
	    <link> tag is spec-compliant, parallel-loadable, and faster. -#}
	<link rel="stylesheet" href="{{ media }}/css/features.css?v={{ cb }}">
	{% if (nodespec && nodespec.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ nodespec.css }}">
	{% endif -%}

	<script src="{{ url('admin/translations', lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
	<script src="{{ resource }}/luci.js?v={{ cb }}"></script>
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}
</head>
	<body class="lang_{{ lang }} {% if (request && request.authsession): %}logged-in{% endif %} {% if (path != ''): %}node-{{ path }}{% else %}node-main-login{% endif %}" data-page="{{ pcdata(path) }}">
<header>
	<div class="fill">
		<div class="container">
			<button type="button" class="showSide" aria-label="{{ translate('Toggle menu') }}"></button>
			<a class="brand" href="{{ url('admin/status/overview') }}">{{ striptags(boardinfo.hostname || "OpenWrt") }}</a>
			<div class="status" id="indicators"></div>
			<button type="button" id="cmdk-trigger" class="cmdk-trigger" aria-label="{{ translate('Search menus (Cmd+K)') }}" title="{{ translate('Search (⌘K / Ctrl+K)') }}">
				<svg class="svg-icon"><use href="{{ media }}/icons.svg#i-search"/></svg>
			</button>
			<button type="button" id="quick-actions-trigger" class="quick-actions-trigger" aria-label="{{ translate('Quick actions') }}" title="{{ translate('Quick actions') }}">
				<svg class="svg-icon"><use href="{{ media }}/icons.svg#i-zap"/></svg>
			</button>
			<button type="button" id="theme-toggle" class="theme-toggle" aria-label="{{ translate('Switch theme') }}" title="{{ translate('Switch theme') }}">
				<svg class="svg-icon icon-auto"><use href="{{ media }}/icons.svg#i-monitor"/></svg>
				<svg class="svg-icon icon-light"><use href="{{ media }}/icons.svg#i-sun"/></svg>
				<svg class="svg-icon icon-dark"><use href="{{ media }}/icons.svg#i-moon"/></svg>
			</button>
		</div>
	</div>
</header>

{#- Step 104 (Round 22): bottom navbar upgraded to preview-parity design.
    Each tab now has:
      - SVG icon from icons.svg sprite (replaces 28-px PNG)
      - Visible text label below the icon (10 px in preview spec)
      - .navbar-tab-{home|proxy|network|stats|admin} class so CSS can
        cross-match against body[data-page^="..."] for active state.
    Icon ↔ section map (consistent with preview's iPhone mockup):
      Overview  → i-home
      OpenClash → i-globe  (preview's proxy slot)
      Network   → i-network
      Realtime  → i-bar-chart
      Admin     → i-user
-#}
<div class="navbar">
  <a class="navbar-tab navbar-tab-home" href="{{ url('admin/status/overview') }}">
    <svg class="navbar-tab-icon" aria-hidden="true"><use href="{{ media }}/icons.svg#i-home"/></svg>
    <span class="navbar-tab-label">{{ translate('Home') }}</span>
  </a>
  {% if (dispatcher.lookup('admin/services/openclash')): %}
  <a class="navbar-tab navbar-tab-proxy" href="{{ url('admin/services/openclash') }}">
    <svg class="navbar-tab-icon" aria-hidden="true"><use href="{{ media }}/icons.svg#i-globe"/></svg>
    <span class="navbar-tab-label">OpenClash</span>
  </a>
  {% endif %}
  <a class="navbar-tab navbar-tab-network" href="{{ url('admin/network/network') }}">
    <svg class="navbar-tab-icon" aria-hidden="true"><use href="{{ media }}/icons.svg#i-network"/></svg>
    <span class="navbar-tab-label">{{ translate('Network') }}</span>
  </a>
  <a class="navbar-tab navbar-tab-stats" href="{{ url('admin/status/realtime') }}">
    <svg class="navbar-tab-icon" aria-hidden="true"><use href="{{ media }}/icons.svg#i-bar-chart"/></svg>
    <span class="navbar-tab-label">{{ translate('Graphs') }}</span>
  </a>
  <a class="navbar-tab navbar-tab-admin" href="{{ url('admin/system/admin') }}">
    <svg class="navbar-tab-icon" aria-hidden="true"><use href="{{ media }}/icons.svg#i-user"/></svg>
    <span class="navbar-tab-label">{{ translate('Admin') }}</span>
  </a>
</div>

<div class="main">
	<div style="" class="loading"><span><div class="loading-img"></div>{{ translate('Collecting data...') }}</span></div>
	<div class="main-left" id="mainmenu" style="display:none"></div>
	<div class="main-right">
		<div class="modemenu-buttons" style="display:none">
			<ul id="modemenu"></ul>
		</div>
		<div class="darkMask"></div>
		<div id="maincontent">
			<div class="container">
				{%- if (root_no_pw && path != "admin-system-admin-password"): -%}
				<div class="alert-message warning">
					<h4>{{ translate('No password set!') }}</h4>
					<p>{{ translate('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					<div class="right"><a class="btn cbi-button cbi-button-apply" href="{{ url('admin/system/admin') }}">{{ translate('Go to password configuration...') }}</a></div>
				</div>
				{%- endif -%}

				<noscript>
					<div class="alert-message warning">
						<h4>{{ translate('JavaScript required!') }}</h4>
						<p>{{ translate('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" style="display:none"></div>
	<script src="{{ media }}/js/style.js?v={{ cb }}"></script>
