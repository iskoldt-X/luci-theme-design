-#}

{#- luciname, luciversion, distversion are provided as template globals
    in the ucode runtime — no `require` needed (Lua counterpart had
    `local ver = require "luci.version"`). -#}
	</div>
	<footer class="mobile-hide">
	<a href="https://github.com/openwrt/luci">Powered by {{ luciname }} ({{ luciversion }})</a> / {{ distversion }}
	</footer>
	</div>
</div>

{#- All 12 theme JS modules — paths match Step 158's resources/design-x/
    namespace, so L.require('design-x.foo') resolves to
    /luci-static/resources/design-x/foo.js. -#}
<script type="text/javascript">L.require('design-x.menu-design')</script>
<script type="text/javascript">L.require('design-x.toast')</script>
<script type="text/javascript">L.require('design-x.cmdk')</script>
<script type="text/javascript">L.require('design-x.wan-stats')</script>
<script type="text/javascript">L.require('design-x.wan-hero')</script>
<script type="text/javascript">L.require('design-x.sparkline')</script>
<script type="text/javascript">L.require('design-x.speedtest')</script>
<script type="text/javascript">L.require('design-x.devices')</script>
<script type="text/javascript">L.require('design-x.traffic')</script>
<script type="text/javascript">L.require('design-x.quick-actions')</script>
<script type="text/javascript">L.require('design-x.apply-modal')</script>
<script type="text/javascript">L.require('design-x.i18n-debug')</script>

</body>
</html>
