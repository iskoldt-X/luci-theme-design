{#-
	Material is a clean HTML5 theme for LuCI. It is based on luci-theme-bootstrap and MUI

	luci-theme-material
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	luci-theme-bootstrap:
	Copyright 2008 Steven Barth <steven@midlink.org>
	Copyright 2008 Jo-Philipp Wich <jow@openwrt.org>
	Copyright 2012 David Menting <david@nut-bolt.nl>

	luci-theme-design-x (Round 42 fork, Step 175 — bootstrap-aligned ucode rewrite)

	Licensed to the public under the Apache License 2.0
-#}

{#- luciname / luciversion / distversion are NOT confirmed to be ucode
    template globals in LuCI 24.10. bootstrap's footer.ut likely uses
    them; until verified, fall back to safe defaults via ?? coalescing
    so the template never crashes on a missing global. The version
    line is informational only — fallback to "LuCI" with no version
    is acceptable degradation. -#}
	</div>
	<footer class="mobile-hide">
	<a href="https://github.com/openwrt/luci">Powered by {{ luciname ?? 'LuCI' }} ({{ luciversion ?? '' }})</a> / {{ distversion ?? '' }}
	</footer>
	</div>
</div>

{#- All 12 theme JS modules — paths match Step 158's resources/design-x/
    namespace, so L.require('design-x.foo') resolves to
    /luci-static/resources/design-x/foo.js. -#}
<script type="text/javascript">L.require('design-x.menu-design')</script>
<script type="text/javascript">L.require('design-x.toast')</script>
<script type="text/javascript">L.require('design-x.cmdk')</script>
<script type="text/javascript">L.require('design-x.wan-stats')</script>
<script type="text/javascript">L.require('design-x.wan-hero')</script>
<script type="text/javascript">L.require('design-x.sparkline')</script>
<script type="text/javascript">L.require('design-x.speedtest')</script>
<script type="text/javascript">L.require('design-x.devices')</script>
<script type="text/javascript">L.require('design-x.quick-actions')</script>
<script type="text/javascript">L.require('design-x.apply-modal')</script>
<script type="text/javascript">L.require('design-x.i18n-debug')</script>

</body>
</html>
