# luci-theme-design-x — Round 46 Step 242 — Block feature
#
# This file is auto-regenerated by the rpcd handler on every
# Block / Unblock action. Manual edits will be overwritten on
# next action. To wipe all blocks manually:
#
#     rm /usr/share/nftables.d/table-post/design_x.nft && fw4 reload
#
# Architecture (locked in Round 46 verification):
#   - Standalone `inet` family table (does NOT inject into fw4's
#     chains; fw4's reload doesn't disturb our state).
#   - `ether_addr` set typed for MAC literals; verified working on
#     IW24.10 / nft 1.1.1.
#   - Three hooks (forward / input / output) so a blocked MAC can't
#     reach WAN, can't reach router admin, can't receive replies.
#   - `counter` on each rule for diagnostic visibility via
#     `nft list table inet design_x`.
#   - DROP is final at the filter hook, evaluated BEFORE flow
#     offloading kicks in — Round 44's SFO ghost can't undermine
#     this. Verified: SFO only affects established flows; dropped
#     packets never establish a flow.

table inet design_x {
	set blocked_macs {
		type ether_addr
	}

	chain block_forward {
		type filter hook forward priority filter; policy accept;
		ether saddr @blocked_macs counter drop
		ether daddr @blocked_macs counter drop
	}

	chain block_input {
		type filter hook input priority filter; policy accept;
		ether saddr @blocked_macs counter drop
	}

	chain block_output {
		type filter hook output priority filter; policy accept;
		ether daddr @blocked_macs counter drop
	}
}
