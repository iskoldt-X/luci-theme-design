#!/bin/sh /etc/rc.common
#
# design-host-acct — per-host traffic accounting for the Traffic Analysis card
#
# WHY THIS EXISTS
# ───────────────
# nlbwmon's per-host byte counters are broken when Software Flow Offloading
# is enabled — the offload fastpath bypasses Netfilter conntrack hooks, so
# nlbwmon (which subscribes to conntrack via NFNETLINK_CONNTRACK) sees the
# counter frozen at ~0 for every offloaded flow. Most user routers run with
# offloading on for performance and never realize the per-host metering they
# see is wrong.
#
# HOW IT WORKS
# ────────────
# nftables `bridge` family with prerouting + postrouting hooks. The bridge
# family operates at layer-2 (bridge code) and is INDEPENDENT of inet/
# netfilter — flow offload's nf_flowtable fastpath bypasses the inet
# FORWARD chain only; bridge family chains still fire for every packet
# entering or leaving the bridge.
#
# Two chains:
#   - lan_in   (hook prerouting):  saddr == LAN host  → UPLOAD bytes
#                                   (packet arrives at a bridge port from
#                                    a LAN device — saddr is the host)
#   - lan_out  (hook postrouting): daddr == LAN host  → DOWNLOAD bytes
#                                   (packet about to leave a bridge port
#                                    headed to LAN — by this point inet
#                                    PREROUTING's DNAT has restored daddr
#                                    to the LAN host's IP)
#
# WHY NOT netdev family (Step 117's attempt):
#   netdev/egress hook on br-lan would have given us downloads cleanly.
#   But kernel CONFIG_NETFILTER_EGRESS is OFF in stock ImmortalWrt 24.10
#   builds (and most OpenWrt builds) — `nft add chain ... hook egress`
#   returns "Chain of type filter is not supported". Bridge family is
#   universally enabled on every OpenWrt build going back to 17.x, no
#   kernel rebuild needed.
#
# WHY NOT wan ingress (Step 115's original attempt):
#   At the moment a download packet arrives at WAN (eth1) ingress, its
#   daddr is the router's PUBLIC IP — NAT/DNAT happens in PREROUTING and
#   restores the LAN host's IP only afterwards. So `ip daddr 192.168.45.X`
#   at WAN ingress can never match.
#
# Counter naming: `host_tx_<ip_underscored>` / `host_rx_<ip_underscored>`
# (nftables identifiers can't contain dots, so 192.168.45.225 becomes
# 192_168_45_225 for the name).
#
# Round 31:
#   Step 115 (initial): netdev family with eth1-ingress for RX — fundamentally
#     broken because NAT hadn't run yet at that hook point. TX worked.
#   Step 117 (fix-up):  switched RX to br-lan netdev/egress — sound design
#     but kernel CONFIG missing, chain creation failed at runtime.
#   Step 118 (THIS):    switched to bridge family — universally available,
#     same offload-proof property, both directions work.
# ─────────────────────────────────────────────────────────────────────────

START=99
STOP=10

NFT_TABLE="design_acct"
DHCP_LEASES="/tmp/dhcp.leases"

EXTRA_COMMANDS="refresh"
EXTRA_HELP="    refresh    Rescan DHCP leases; add new host counters"

# Sanitize IP into nft-safe identifier (dots → underscores). Also gate
# against weird input (no shell escape chars).
ip_to_id() {
	echo "$1" | tr '.' '_' | tr -cd 'a-zA-Z0-9_'
}

# Add per-host counters + rules. Idempotent — `nft add` silently no-ops if
# the object already exists with the same definition.
add_host_counter() {
	local ip="$1"
	local id

	# Skip malformed
	case "$ip" in
		*[!0-9.]*) return 1 ;;
		"") return 1 ;;
	esac
	id=$(ip_to_id "$ip")
	[ -z "$id" ] && return 1

	nft add counter bridge "$NFT_TABLE" "host_tx_$id" 2>/dev/null
	nft add counter bridge "$NFT_TABLE" "host_rx_$id" 2>/dev/null

	# UPLOAD: packets entering the bridge from a LAN port on their way
	# out to the WAN — saddr is the LAN host's IP.
	nft add rule bridge "$NFT_TABLE" lan_in \
		ip saddr "$ip" counter name "host_tx_$id" 2>/dev/null

	# DOWNLOAD: packets about to leave the bridge via a LAN port. By
	# this stage, inet PREROUTING's DNAT has restored daddr to the LAN
	# host's IP (whereas at WAN eth1 ingress it was still the router's
	# public IP — see file header for full reasoning).
	nft add rule bridge "$NFT_TABLE" lan_out \
		ip daddr "$ip" counter name "host_rx_$id" 2>/dev/null
}

# Build the table + chains from scratch. Wipes any prior state — used on
# start. After this returns, counters exist for all currently-known DHCP
# hosts; new leases get added via refresh().
setup_table() {
	# Hard reset (catches the transition from Step 115/117's netdev
	# table layout to Step 118's bridge family — delete both, only
	# the family in use will exist anyway)
	nft delete table netdev "$NFT_TABLE" 2>/dev/null
	nft delete table bridge "$NFT_TABLE" 2>/dev/null

	# Pre-flight: nft itself missing? Don't crash the rest of boot.
	command -v nft >/dev/null 2>&1 || {
		logger -t design-host-acct "nft binary missing; aborting"
		return 1
	}

	# Pre-flight: nftables operational?
	if ! nft list tables 2>/dev/null | grep -q ''; then
		logger -t design-host-acct "nftables non-functional; aborting"
		return 1
	fi

	nft add table bridge "$NFT_TABLE" 2>/dev/null || {
		logger -t design-host-acct "failed to create bridge table"
		return 1
	}

	# LAN ingress chain — packets entering the bridge FROM a LAN port.
	# Bridge family hooks operate at layer-2; flow offload (inet/forward
	# layer) doesn't bypass these.
	nft add chain bridge "$NFT_TABLE" lan_in \
		"{ type filter hook prerouting priority -300 ; }" \
		2>/dev/null || {
		logger -t design-host-acct "failed to add lan_in chain (bridge prerouting)"
	}

	# LAN egress chain — packets about to leave the bridge TO a LAN
	# port. At bridge postrouting, inet's PREROUTING DNAT has already
	# restored daddr to the LAN host's IP, so `ip daddr 192.168.45.X`
	# matches correctly. Bridge family postrouting is universally
	# available on every OpenWrt build — no kernel CONFIG_NETFILTER_EGRESS
	# dependency.
	nft add chain bridge "$NFT_TABLE" lan_out \
		"{ type filter hook postrouting priority -300 ; }" \
		2>/dev/null || {
		logger -t design-host-acct "failed to add lan_out chain (bridge postrouting)"
	}

	# Initial population from current DHCP lease table.
	refresh_hosts
}

# Add counters for hosts that aren't yet covered. Idempotent — existing
# counters are preserved (bytes don't reset).
refresh_hosts() {
	local ip
	local existing_ips

	[ -r "$DHCP_LEASES" ] || return 0

	# Get current counter names → IP set (so we can skip already-tracked).
	existing_ips=$(nft -j list table bridge "$NFT_TABLE" 2>/dev/null | \
		jsonfilter -e '@.nftables[*].counter.name' 2>/dev/null | \
		grep '^host_tx_' | sed 's/^host_tx_//' | tr '_' '.' | sort -u)

	# Walk DHCP leases (col 3 = IP). Add any IP not already counted.
	awk '{print $3}' "$DHCP_LEASES" 2>/dev/null | sort -u | while read ip; do
		if ! echo "$existing_ips" | grep -qx "$ip"; then
			add_host_counter "$ip"
		fi
	done
}

start() {
	setup_table
}

stop() {
	# Delete both families — only the active one (bridge in Step 118+)
	# will succeed; the other returns silently. Catches migration from
	# Step 115/117's netdev layout if both happened to coexist briefly.
	nft delete table bridge "$NFT_TABLE" 2>/dev/null
	nft delete table netdev "$NFT_TABLE" 2>/dev/null
}

restart() {
	stop
	start
}

reload() {
	refresh_hosts
}

refresh() {
	refresh_hosts
}
