#!/bin/sh /etc/rc.common
#
# design-host-acct — per-host traffic accounting for the Traffic Analysis card
#
# WHY THIS EXISTS
# ───────────────
# nlbwmon's per-host byte counters are broken when Software Flow Offloading
# is enabled — the offload fastpath bypasses Netfilter conntrack hooks, so
# nlbwmon (which subscribes to conntrack via NFNETLINK_CONNTRACK) sees the
# counter frozen at ~0 for every offloaded flow. Most user routers run with
# offloading on for performance and never realize the per-host metering they
# see is wrong.
#
# HOW IT WORKS
# ────────────
# nftables `netdev` family with ingress/egress hooks fire at the device-
# level RX/TX point, where flow-offloaded packets are still visible (offload
# only bypasses the netfilter FORWARD chain — netdev hooks are upstream).
#
# Two chains, both on br-lan (the LAN bridge):
#   - lan_in  (ingress on br-lan):  saddr == LAN host → UPLOAD bytes
#   - lan_out (egress  on br-lan):  daddr == LAN host → DOWNLOAD bytes
#
# Why egress on br-lan instead of ingress on WAN (Step 115's broken
# original design):
#   When a download packet arrives at WAN (eth1) ingress, its destination
#   address is the router's PUBLIC IP — NAT (DNAT via conntrack) hasn't
#   happened yet. The LAN host's IP is only restored at PREROUTING. By the
#   time the packet exits br-lan headed for the LAN device, DNAT has
#   completed and daddr is the real LAN host IP. So br-lan egress sees
#   the correct daddr to match against.
#
# Counter naming: `host_tx_<ip_underscored>` / `host_rx_<ip_underscored>`
# (nftables identifiers can't contain dots, so 192.168.45.225 becomes
# 192_168_45_225 for the name).
#
# Kernel requirement: netdev/egress hook needs Linux 5.16+. ImmortalWrt
# 24.10 ships kernel 6.6 — well past that. OpenWrt 22.03/23.05 also fine.
#
# Round 31 / Step 115 (2026-05-23). Step 117 (Round 31 fix-up) — switched
# from broken eth1-ingress to br-lan-egress for download direction.
# ─────────────────────────────────────────────────────────────────────────

START=99
STOP=10

NFT_TABLE="design_acct"
LAN_DEV="br-lan"
DHCP_LEASES="/tmp/dhcp.leases"

EXTRA_COMMANDS="refresh"
EXTRA_HELP="    refresh    Rescan DHCP leases; add new host counters"

# Sanitize IP into nft-safe identifier (dots → underscores). Also gate
# against weird input (no shell escape chars).
ip_to_id() {
	echo "$1" | tr '.' '_' | tr -cd 'a-zA-Z0-9_'
}

# Add per-host counters + rules. Idempotent — `nft add` silently no-ops if
# the object already exists with the same definition.
add_host_counter() {
	local ip="$1"
	local id

	# Skip malformed
	case "$ip" in
		*[!0-9.]*) return 1 ;;
		"") return 1 ;;
	esac
	id=$(ip_to_id "$ip")
	[ -z "$id" ] && return 1

	nft add counter netdev "$NFT_TABLE" "host_tx_$id" 2>/dev/null
	nft add counter netdev "$NFT_TABLE" "host_rx_$id" 2>/dev/null

	# UPLOAD: packets entering br-lan from a LAN device on their way out
	# to the WAN — saddr is the LAN host's IP.
	nft add rule netdev "$NFT_TABLE" lan_in \
		ip saddr "$ip" counter name "host_tx_$id" 2>/dev/null

	# DOWNLOAD: packets exiting br-lan headed back to the LAN device.
	# By this stage of the pipeline, conntrack's DNAT has restored
	# daddr to the LAN host's IP (whereas at eth1 ingress it was still
	# the router's public WAN IP — see file header for full reasoning).
	nft add rule netdev "$NFT_TABLE" lan_out \
		ip daddr "$ip" counter name "host_rx_$id" 2>/dev/null
}

# Build the table + chains from scratch. Wipes any prior state — used on
# start. After this returns, counters exist for all currently-known DHCP
# hosts; new leases get added via refresh().
setup_table() {
	# Hard reset
	nft delete table netdev "$NFT_TABLE" 2>/dev/null

	# Pre-flight: nft itself missing? Don't crash the rest of boot.
	command -v nft >/dev/null 2>&1 || {
		logger -t design-host-acct "nft binary missing; aborting"
		return 1
	}

	# Pre-flight: netdev family loaded? Kernel module nf_tables_netdev
	# needs to be available. Most OpenWrt 22.03+ builds have this.
	if ! nft list tables 2>/dev/null | grep -q ''; then
		logger -t design-host-acct "nftables non-functional; aborting"
		return 1
	fi

	nft add table netdev "$NFT_TABLE" 2>/dev/null || {
		logger -t design-host-acct "failed to create netdev table"
		return 1
	}

	# LAN ingress chain — packets entering br-lan FROM a LAN host.
	# priority -300 places this before any conntrack hooks (around 0).
	nft add chain netdev "$NFT_TABLE" lan_in \
		"{ type filter hook ingress device $LAN_DEV priority -300 ; }" \
		2>/dev/null || {
		logger -t design-host-acct "failed to add lan_in chain"
	}

	# LAN egress chain — packets leaving br-lan TO a LAN host. Critical
	# that this is egress and NOT ingress on the WAN device; at WAN
	# ingress the daddr is the router's public IP (NAT hasn't run yet).
	# Egress hook requires kernel 5.16+; if missing the `nft add chain`
	# returns non-zero and we log a warning. Without it downloads will
	# not be tracked but uploads (lan_in) still work.
	nft add chain netdev "$NFT_TABLE" lan_out \
		"{ type filter hook egress device $LAN_DEV priority -300 ; }" \
		2>/dev/null || {
		logger -t design-host-acct \
			"failed to add lan_out chain — kernel lacks netdev egress hook? Downloads will be 0."
	}

	# Initial population from current DHCP lease table.
	refresh_hosts
}

# Add counters for hosts that aren't yet covered. Idempotent — existing
# counters are preserved (bytes don't reset).
refresh_hosts() {
	local ip
	local existing_ips

	[ -r "$DHCP_LEASES" ] || return 0

	# Get current counter names → IP set (so we can skip already-tracked).
	existing_ips=$(nft -j list table netdev "$NFT_TABLE" 2>/dev/null | \
		jsonfilter -e '@.nftables[*].counter.name' 2>/dev/null | \
		grep '^host_tx_' | sed 's/^host_tx_//' | tr '_' '.' | sort -u)

	# Walk DHCP leases (col 3 = IP). Add any IP not already counted.
	awk '{print $3}' "$DHCP_LEASES" 2>/dev/null | sort -u | while read ip; do
		if ! echo "$existing_ips" | grep -qx "$ip"; then
			add_host_counter "$ip"
		fi
	done
}

start() {
	setup_table
}

stop() {
	nft delete table netdev "$NFT_TABLE" 2>/dev/null
}

restart() {
	stop
	start
}

reload() {
	refresh_hosts
}

refresh() {
	refresh_hosts
}
