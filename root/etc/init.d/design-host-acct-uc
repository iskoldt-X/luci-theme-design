#!/bin/sh /etc/rc.common
#
# design-host-acct-uc — Round 44 Step 210 (Phase 1) procd wrapper for
# /usr/sbin/design-host-acct.uc.
#
# This is a PARALLEL service to the Round 31 design-host-acct nft-bridge
# daemon (doc/bandwith.md §8 Step 195: "Widget still on old data —
# safe parallel run for observability"). Both services run side-by-side.
# Step 213 will delete the Round 31 init.d + nft table once Phase 2 is
# validated.
#
# What this service does:
#   - launches `ucode /usr/sbin/design-host-acct.uc`
#   - procd supervises (auto-restart on crash, respawn rate-limited)
#   - daemon listens NFNLGRP_CONNTRACK_DESTROY, parses TLV, accumulates
#     per-MAC totals, writes /tmp/design-host-traffic.json every 5 s
#
# Hard dependency: net.netfilter.nf_conntrack_acct=1 sysctl (Round 44
# Step 207 ships /etc/sysctl.d/11-design-conntrack-acct.conf to set it).
# Without that sysctl, every flow reports zero bytes.

USE_PROCD=1
START=99
STOP=09

DAEMON_SCRIPT="/usr/sbin/design-host-acct.sh"
NFT_BIN="/usr/sbin/nft"

start_service() {
    # Round 44 Step 223: daemon impl migrated again, this time from
    # `conntrack -E` subprocess (Step 219) to reading Round 31's nft
    # bridge counters directly. The conntrack -E path was empirically
    # blocked by ImmortalWrt 24.10's default flow_offloading=1,
    # flow_offloading_hw=1 — DESTROY events never fire for offloaded
    # flows. See memory/ucode-socket-no-netlink.md for the cascade.
    # New impl needs only: nftables binary + Round 31 service alive.
    if [ ! -x "$DAEMON_SCRIPT" ]; then
        logger -t design-host-acct "daemon script $DAEMON_SCRIPT missing"
        return 1
    fi

    # Round 44 Step 226: daemon now reads /proc/net/nf_conntrack (Tier 0,
    # the only kernel surface that survives SFO + HFO byte accounting).
    # Hard prereq: net.netfilter.nf_conntrack_acct=1. Without it, the
    # `bytes=N` fields in the conntrack table are always 0 → daemon
    # accumulates zero. Step 207 ships /etc/sysctl.d/11-design-conntrack-acct.conf
    # to set this.
    local acct=$(sysctl -n net.netfilter.nf_conntrack_acct 2>/dev/null)
    if [ "$acct" != "1" ]; then
        logger -t design-host-acct \
            "WARN: net.netfilter.nf_conntrack_acct=$acct (need 1 — flows will all read 0 bytes; run: sysctl -p /etc/sysctl.d/11-design-conntrack-acct.conf)"
    fi

    # Round 44 Step 226: pre-clean any orphan daemon from prior installs.
    # busybox pkill -f doesn't do regex, so a manual PID-by-cmdline scan
    # is the only reliable way. Skips self's $$ via PIDFILE check inside
    # the daemon's own startup lock.
    for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        if [ -r "/proc/$pid/cmdline" ]; then
            if grep -q "design-host-acct.sh" "/proc/$pid/cmdline" 2>/dev/null; then
                if [ "$pid" != "$$" ]; then
                    kill -9 "$pid" 2>/dev/null
                fi
            fi
        fi
    done
    sleep 1

    procd_open_instance "design-host-acct"
    procd_set_param command /bin/sh "$DAEMON_SCRIPT"
    procd_set_param respawn 60 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file "$DAEMON_SCRIPT"
    procd_set_param pidfile "/var/run/design-host-acct-uc.pid"
    procd_close_instance
}

stop_service() {
    :
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_raw_trigger \
        "/etc/sysctl.d/11-design-conntrack-acct.conf" 5000 \
        /etc/init.d/design-host-acct-uc restart
}
