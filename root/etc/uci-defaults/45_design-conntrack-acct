#!/bin/sh
# Round 44 Step 207 — apply the conntrack-acct sysctl immediately on
# first install, so the user doesn't need to reboot for accounting to
# start working. uci-defaults runs once after package install, then
# the file is removed by procd.
#
# Why we explicitly `sysctl -p` and don't trust /etc/init.d/sysctl:
# /etc/init.d/sysctl reads /etc/sysctl.d/*.conf at boot. On a fresh
# install we want the setting to take effect NOW — before the user
# expects bandwidth accounting to work. Calling sysctl -p applies our
# specific file without rebooting.
#
# If the sysctl write fails (impossible kernel without CONFIG_NF_CONNTRACK_ACCT
# would be the only realistic reason), we log a notice and exit 0 so
# uci-defaults doesn't loop. The Step 208+ ucode daemon will see
# every flow report zero bytes, which the user will notice in the
# widget — that's the bug surface, not a silent failure.
#
# Reference: doc/bandwith.md §2.119

set -e

if [ ! -f /etc/sysctl.d/11-design-conntrack-acct.conf ]; then
    logger -t luci-theme-design-x \
        "11-design-conntrack-acct.conf missing — bandwidth accounting will read zero"
    exit 0
fi

# Apply just our file (not all of sysctl.d, which other packages may
# have queued for boot-time apply).
sysctl -p /etc/sysctl.d/11-design-conntrack-acct.conf 2>/dev/null || \
    logger -t luci-theme-design-x \
        "sysctl -p failed — kernel may lack CONFIG_NF_CONNTRACK_ACCT support"

# Sanity: read back to confirm it stuck. If conntrack-acct is
# unsupported (rare), the file appears to write but reads back as 0.
CURRENT=$(sysctl -n net.netfilter.nf_conntrack_acct 2>/dev/null || echo "?")
if [ "$CURRENT" = "1" ]; then
    logger -t luci-theme-design-x \
        "conntrack accounting enabled (nf_conntrack_acct=1)"
else
    logger -t luci-theme-design-x \
        "WARN: nf_conntrack_acct=$CURRENT (expected 1) — bandwidth widget may show zeros"
fi

exit 0
