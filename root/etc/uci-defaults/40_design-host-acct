#!/bin/sh
#
# 40_design-host-acct — first-boot wiring for the per-host accounting service
#
# Runs once on theme install (and on each major upgrade, idempotently).
# Enables the init.d/design-host-acct service + adds a 5-minute cron refresh
# so new DHCP leases get picked up without manual intervention.
#
# Round 31 / Step 115 (2026-05-23).

# Enable + start the service. The `enable` symlinks it under /etc/rc.d/,
# the `start` brings it up immediately so the user doesn't have to wait
# for the next boot.
if [ -x /etc/init.d/design-host-acct ]; then
	/etc/init.d/design-host-acct enable 2>/dev/null
	/etc/init.d/design-host-acct start 2>/dev/null
fi

# Add cron refresh — every 5 minutes, scan DHCP leases for new hosts +
# re-detect the WAN device if it changed (PPPoE reconnect, WAN restart,
# etc.). Idempotent: only adds the line if it isn't already there.
if ! grep -qF "design-host-acct refresh" /etc/crontabs/root 2>/dev/null; then
	[ -f /etc/crontabs/root ] || touch /etc/crontabs/root
	echo "*/5 * * * * /etc/init.d/design-host-acct refresh >/dev/null 2>&1" \
		>> /etc/crontabs/root
	/etc/init.d/cron restart 2>/dev/null
fi

exit 0
