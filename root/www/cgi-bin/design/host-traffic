#!/bin/sh
# Theme-provided CGI: per-host traffic counters from nftables.
#
# Output JSON:
#   {
#     "available": true|false,
#     "reason": "..." (optional),
#     "hosts": [ { "ip": "192.168.45.225", "tx_bytes": N, "rx_bytes": N }, ... ]
#   }
#
# Data source: nftables `netdev design_acct` table created by the
# /etc/init.d/design-host-acct service. That service installs `ingress`-hook
# counters that survive Software Flow Offloading (offload bypasses
# conntrack, but the netdev/ingress hook fires before the fastpath
# divergence — counters see every packet regardless).
#
# tx_bytes = upload (LAN host → outside), measured on br-lan ingress
# rx_bytes = download (outside → LAN host), measured on WAN dev ingress
#
# If the acct table doesn't exist yet (service not installed, or kernel
# missing netdev family), returns available:false. Frontend falls back to
# nlbwmon or the empty state.
#
# Round 31 / Step 115 (2026-05-23). Companion to /etc/init.d/design-host-acct.

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

NFT_TABLE="design_acct"

# Probe: does the acct table exist? (Service might not be running yet.)
if ! nft list table netdev "$NFT_TABLE" >/dev/null 2>&1; then
	echo '{"available":false,"hosts":[],"reason":"no-acct-table"}'
	exit 0
fi

# Dump counters as JSON, extract names + byte counts in parallel arrays,
# then pair them with awk. Busybox jsonfilter doesn't emit paired tuples
# but separate -e queries produce parallel ordered output we can zip.

RAW=$(nft -j list table netdev "$NFT_TABLE" 2>/dev/null)
if [ -z "$RAW" ]; then
	echo '{"available":true,"hosts":[],"reason":"empty-output"}'
	exit 0
fi

# Single nft call → two parallel-ordered queries via jsonfilter.
# busybox ash doesn't support process substitution `<(…)`, so we feed
# both arrays into one awk invocation as a sentinel-divided stream and
# zip them index-by-index inside awk. Single subshell, no temp files,
# fully POSIX.
NAMES=$(echo "$RAW" | jsonfilter -e '@.nftables[*].counter.name')
BYTES=$(echo "$RAW" | jsonfilter -e '@.nftables[*].counter.bytes')

{
	echo "$NAMES"
	echo "---SEP---"
	echo "$BYTES"
} | awk '
	/^---SEP---$/ { phase = 1; idx = 0; next }
	phase == 0 { names[++ncount] = $0; next }
	phase == 1 { bytes[++idx] = $0 + 0 }

	END {
		# Zip + bucket
		for (i = 1; i <= ncount; i++) {
			name = names[i]
			b = bytes[i] + 0
			if (name ~ /^host_tx_/) {
				ip = substr(name, 9); gsub("_", ".", ip)
				tx[ip] = b
			} else if (name ~ /^host_rx_/) {
				ip = substr(name, 9); gsub("_", ".", ip)
				rx[ip] = b
			}
		}

		# Union of all IPs seen in either direction
		for (ip in tx) seen[ip] = 1
		for (ip in rx) seen[ip] = 1

		printf "{\"available\":true,\"hosts\":["
		first = 1
		for (ip in seen) {
			t = (ip in tx) ? tx[ip] : 0
			r = (ip in rx) ? rx[ip] : 0
			# Skip zero-zero — host has counter but never transferred
			if (t == 0 && r == 0) continue
			if (!first) printf ","
			printf "{\"ip\":\"%s\",\"tx_bytes\":%d,\"rx_bytes\":%d}", ip, t, r
			first = 0
		}
		printf "]}\n"
	}
'
