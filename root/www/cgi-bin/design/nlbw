#!/bin/sh
# Theme-provided CGI: nlbwmon traffic accounting proxy.
# Calls the `nlbw` CLI (from luci-app-nlbwmon / nlbwmon) to dump current
# bandwidth accounting state as JSON. Returns empty array if nlbwmon isn't
# installed or the command fails.
#
# See doc/upgrade.md §5.D2 and §0.5.
#
# Output format (whatever nlbw emits — JS side handles both flavours):
#   either: [{"mac":"aa:bb:...","rx_bytes":N,"tx_bytes":N,...}, ...]
#   or:     {"columns":["mac","rx_bytes",...], "data":[["aa:bb:...",N,...],...]}

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

if command -v nlbw >/dev/null 2>&1; then
	# -c json: JSON output. -g mac: group by MAC (one entry per device).
	# Some nlbw builds reject -g; fall through to bare `-c json`.
	nlbw -c json -g mac 2>/dev/null \
		|| nlbw -c json 2>/dev/null \
		|| echo '[]'
else
	echo '[]'
fi
