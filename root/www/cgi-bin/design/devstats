#!/bin/sh
# devstats — Read /sys/class/net/<dev>/statistics/{rx,tx}_bytes
#
# Step 53 (2026-05-23): Replaces our wan-stats.js's failing RPC call to
# network.device.status, which LuCI 26.x session ACL rejects with
# `-32002 Access denied` even though `ubus call network.device status`
# works fine from SSH. /sys/class/net/ is world-readable, so a tiny
# shell CGI reads the same counters without any auth/ACL friction.
#
# Usage:   GET /cgi-bin/design/devstats?dev=eth1
# Returns: {"dev":"eth1","up":true,"rx_bytes":18014398,"tx_bytes":6103929}
#
# Safety:
#   - Device name strictly filtered to [A-Za-z0-9._-] via `tr -cd`.
#   - Reject explicit ".", "..", or any name containing "..".
#   - Verify /sys/class/net/<dev>/statistics exists before reading
#     (rejects path-traversal attempts even if filter were bypassed).

DEV="${QUERY_STRING#*dev=}"
DEV="${DEV%%&*}"
DEV=$(printf '%s' "$DEV" | tr -cd 'a-zA-Z0-9._-')

case "$DEV" in
	""|"."|".."|*..*)
		DEV=""
		;;
esac

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

if [ -z "$DEV" ] || [ ! -d "/sys/class/net/$DEV/statistics" ]; then
	echo '{"error":"invalid device","rx_bytes":0,"tx_bytes":0,"up":false}'
	exit 0
fi

RX=$(cat "/sys/class/net/$DEV/statistics/rx_bytes" 2>/dev/null || echo 0)
TX=$(cat "/sys/class/net/$DEV/statistics/tx_bytes" 2>/dev/null || echo 0)
UP="false"
[ "$(cat /sys/class/net/$DEV/operstate 2>/dev/null)" = "up" ] && UP="true"

printf '{"dev":"%s","up":%s,"rx_bytes":%s,"tx_bytes":%s}\n' \
	"$DEV" "$UP" "$RX" "$TX"
